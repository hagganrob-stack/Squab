# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — leave blank to run on the bundled demo dataset
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_ or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Email (Phase 3+)
RESEND_API_KEY=
EMAIL_FROM="Squab Connect <connect@example.com>"

# Vercel Cron authentication (Phase 3+)
CRON_SECRET=


# Google reviews on the homepage (Squab Workspace, Leamington Spa). Server-only.
# Needs the Places API (New) enabled; restrict the key to that API.
GOOGLE_PLACES_API_KEY=
# The Business Profile's place ID, e.g. ChIJ...
GOOGLE_PLACE_ID=
# Optional: the profile's "Ask for reviews" share link (g.page/r/.../review)
GOOGLE_REVIEW_URL=
