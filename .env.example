SUPABASE_SERVICE_ROLE_KEY=

# Email (Phase 3+)
RESEND_API_KEY=
EMAIL_FROM="Squab Connect <connect@example.com>"

# Vercel Cron authentication (Phase 3+)
CRON_SECRET=
